# Example only. `npm run setup` writes rayfin/.env.secrets with your values.
# Apply after the app exists: npx rayfin secret set --env-file rayfin/.env.secrets
# A single hyphen for ADLS_ARCHIVE_FOLDER means the container root.

NOTEBOOK_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
STAGING_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
STAGING_LAKEHOUSE_ID=00000000-0000-0000-0000-000000000000
ADLS_ACCOUNT=mystorageaccount
ADLS_CONTAINER=lakehouse-backups
ADLS_ARCHIVE_FOLDER=-
ADMIN_SUBJECTS=admin@contoso.example,00000000-0000-0000-0000-000000000001
