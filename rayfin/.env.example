# Copy to rayfin/.env with `npm run setup`, or fill this in by hand.
# rayfin.yml interpolates DEV_PORT. The frontend build reads the VITE_APP_* values.
# Do not put storage account names, workspace ids, or admin subjects here.

DEV_PORT=5173
VITE_APP_TITLE=Lakehouse Backup & Restore
VITE_APP_SUBTITLE=Back up a Fabric lakehouse to ADLS Gen2 and restore it
VITE_APP_ICON=app-icon.png
